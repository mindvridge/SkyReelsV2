# SkyReels V2 Runpod 환경 변수 설정

# 애플리케이션 모드
NODE_ENV=production
PYTHON_ENV=production

# 백엔드 설정
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://0.0.0.0:8000

# 프론트엔드 설정
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://0.0.0.0:8000

# GPU 설정
CUDA_VISIBLE_DEVICES=0
TORCH_CUDA_ARCH_LIST=7.0;7.5;8.0;8.6;8.9;9.0

# 모델 캐시 디렉토리
HF_HOME=/workspace/SkyReelsV2/backend/models
TRANSFORMERS_CACHE=/workspace/SkyReelsV2/backend/models
HUGGINGFACE_HUB_CACHE=/workspace/SkyReelsV2/backend/models

# 출력 디렉토리
OUTPUT_DIR=/workspace/SkyReelsV2/backend/generated_videos

# 데이터베이스
DATABASE_URL=sqlite:///./app.db

# 로깅
LOG_LEVEL=INFO
LOG_FILE=/workspace/SkyReelsV2/backend/logs/app.log

# PyTorch 설정
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# 메모리 최적화
OMP_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false

# WebSocket 설정
WS_MAX_CONNECTIONS=10
WS_RATE_LIMIT_PER_MINUTE=100

# CORS 설정 (Runpod 도메인)
CORS_ORIGINS=*

# Hugging Face 토큰 (선택사항 - Private 모델 사용시)
# HF_TOKEN=your_huggingface_token_here

# 비디오 생성 기본 설정
DEFAULT_MODEL_SIZE=6B
DEFAULT_RESOLUTION=720P
DEFAULT_NUM_FRAMES=121
DEFAULT_GUIDANCE_SCALE=7.0
DEFAULT_NUM_INFERENCE_STEPS=50

# 최대 동시 생성 수
MAX_CONCURRENT_GENERATIONS=1

# 타임아웃 (초)
VIDEO_GENERATION_TIMEOUT=600

# 디스크 공간 경고 임계값 (GB)
MIN_FREE_SPACE_GB=10
